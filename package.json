{
  "name": "tilt-flight",
  "version": "1.0.0",
  "private": true,
  "description": "スマートフォンの傾きで操縦する3Dフライトゲーム",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.single.config.js",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "vitest run && npm run build && playwright test"
  },
  "dependencies": {
    "peerjs": "^1.5.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
